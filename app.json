{
  "expo": {
    "name": "UmrahConnect",
    "slug": "UmrahConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "umrahconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.umrahconnect.app",
      "backgroundColor": "#1E3A5F",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["uber"]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDpRj_s5Afsb_dEuIpJUDcT78YZDl_6M6g"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.jpg",
        "backgroundColor": "#1E3A5F"
      },
      "package": "com.umrahconnect.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDpRj_s5Afsb_dEuIpJUDcT78YZDl_6M6g"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.jpg"
    },
    "notification": {
      "icon": "./assets/images/logo.jpg",
      "color": "#1E3A5F",
      "sounds": [
        "./assets/audio/azan1.mp3",
        "./assets/audio/azan2.mp3",
        "./assets/audio/azan3.mp3",
        "./assets/audio/azan4.mp3",
        "./assets/audio/azan5.mp3"
      ]
    },
    "plugins": [
  "expo-router",
  [
    "react-native-maps",
    {
      "iosGoogleMapsApiKey": "AIzaSyDpRj_s5Afsb_dEuIpJUDcT78YZDl_6M6g",
      "androidGoogleMapsApiKey": "AIzaSyDpRj_s5Afsb_dEuIpJUDcT78YZDl_6M6g"
    }
  ],
  [
    "@react-native-google-signin/google-signin",
    {
      "iosUrlScheme": "com.googleusercontent.apps.960037449593-nsmd655ofr73ln844jap3171d0s92o17"
    }
  ],
  [
    "expo-splash-screen",
    {
      "image": "./assets/images/logo.jpg",
      "imageWidth": 250,
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    }
  ],
  [
    "expo-notifications",
    {
      "icon": "./assets/images/logo.jpg",
      "color": "#1E3A5F",
      "sounds": [
        "./assets/audio/azan1.mp3",
        "./assets/audio/azan2.mp3",
        "./assets/audio/azan3.mp3",
        "./assets/audio/azan4.mp3",
        "./assets/audio/azan5.mp3"
      ]
    }
  ],
  "@react-native-community/datetimepicker",
  "expo-font",
  "expo-web-browser",
  "expo-audio",
  "expo-apple-authentication",
  [
    "expo-build-properties",
    {
      "ios": {
        "useFrameworks": "static",
        "deploymentTarget": "15.1"
      },
      "android": {
        "compileSdkVersion": 36,
        "targetSdkVersion": 36,
        "minSdkVersion": 24
      }
    }
  ]
],
    
    
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82c12a1f-09a7-416f-bb68-2f9f052bb420"
      }
    }
  }
}
