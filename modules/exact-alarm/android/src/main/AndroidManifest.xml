<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!-- Full Adhan at prayer time (lock screen / other apps), with a Stop button. -->
    <service
      android:name="expo.modules.exactalarm.AdhanService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <receiver
      android:name="expo.modules.exactalarm.AdhanAlarmReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>

    <!-- Home-screen prayer widget: next prayer with a countdown (Premium). -->
    <receiver
      android:name="expo.modules.exactalarm.PrayerWidget"
      android:label="Prayer times"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.exactalarm.PRAYER_WIDGET_REFRESH" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/uc_prayer_widget_info" />
    </receiver>
  </application>
</manifest>
