<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen prayer widget (Premium) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/uc_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/uc_widget_bg"
  android:padding="14dp">

  <LinearLayout
    android:id="@+id/uc_widget_prayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical">
    <TextView
      android:id="@+id/uc_widget_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#C9A84C"
      android:textSize="10sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/uc_widget_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#FFFFFF"
      android:textSize="22sp"
      android:textStyle="bold"
      android:maxLines="1" />
    <TextView
      android:id="@+id/uc_widget_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#E6FFFFFF"
      android:textSize="15sp" />
    <Chronometer
      android:id="@+id/uc_widget_countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#C9A84C"
      android:textSize="18sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/uc_widget_city"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#99FFFFFF"
      android:textSize="10sp"
      android:maxLines="1" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/uc_widget_locked"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:visibility="gone">
    <TextView
      android:id="@+id/uc_widget_locked_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#FFFFFF"
      android:textSize="13sp"
      android:textStyle="bold"
      android:gravity="center" />
    <TextView
      android:id="@+id/uc_widget_locked_sub"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#BFFFFFFF"
      android:textSize="11sp"
      android:gravity="center" />
  </LinearLayout>
</FrameLayout>
